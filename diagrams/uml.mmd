classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_pet(name) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +str frequency
        +bool completed
        +str pet_name
        +date due_date
        +mark_complete() void
        +edit(**changes) void
        +next_occurrence() Task
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +Owner owner
        +list~Task~ plan
        +list~str~ explanations
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed, due_on) list~Task~
        +mark_task_complete(task) Task
        +detect_conflicts(tasks) list~str~
        +generate_plan(day) list~Task~
        +explain_plan() str
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : needs
    Task --> Priority
    Scheduler --> Owner : reads constraints from
    Scheduler ..> Task : selects and orders
